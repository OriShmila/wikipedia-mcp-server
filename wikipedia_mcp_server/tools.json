{
  "name": "Wikipedia",
  "tools": [
    {
      "name": "search_wikipedia",
      "description": "Search Wikipedia for articles matching a query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query to find Wikipedia articles."
          }
        },
        "required": ["query"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Search results with matching Wikipedia articles",
        "properties": {
          "query": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "snippet": { "type": "string" },
                "page_id": { "type": "number" },
                "word_count": { "type": "number" },
                "timestamp": { "type": "string" }
              },
              "required": [
                "title",
                "snippet",
                "page_id",
                "word_count",
                "timestamp"
              ]
            }
          }
        },
        "required": ["query", "results"]
      }
    },
    {
      "name": "get_article",
      "description": "Get the full content of a Wikipedia article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article to retrieve."
          }
        },
        "required": ["title"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Complete Wikipedia article content",
        "properties": {
          "title": { "type": "string" },
          "page_id": { "type": "number" },
          "summary": { "type": "string" },
          "text": { "type": "string" },
          "url": { "type": "string" },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "level": { "type": "number" },
                "text": { "type": "string" },
                "sections": { "type": "array" }
              },
              "required": ["title", "level", "text", "sections"]
            }
          },
          "categories": { "type": "array", "items": { "type": "string" } },
          "links": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "title",
          "page_id",
          "summary",
          "text",
          "url",
          "sections",
          "categories",
          "links"
        ]
      }
    },
    {
      "name": "get_summary",
      "description": "Get a summary of a Wikipedia article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article to summarize."
          }
        },
        "required": ["title"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Wikipedia article summary",
        "properties": {
          "title": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["title", "summary"]
      }
    },
    {
      "name": "summarize_article_for_query",
      "description": "Get a summary of a Wikipedia article tailored to a specific query.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article to summarize."
          },
          "query": {
            "type": "string",
            "description": "The specific query to focus the summary on."
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length of the summary.",
            "minimum": 50,
            "maximum": 1000
          }
        },
        "required": ["title", "query", "max_length"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Query-focused article summary",
        "properties": {
          "title": { "type": "string" },
          "query": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["title", "query", "summary"]
      }
    },
    {
      "name": "summarize_article_section",
      "description": "Get a summary of a specific section of a Wikipedia article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article."
          },
          "section_title": {
            "type": "string",
            "description": "The title of the section to summarize."
          },
          "max_length": {
            "type": "integer",
            "description": "Maximum length of the summary.",
            "minimum": 50,
            "maximum": 500
          }
        },
        "required": ["title", "section_title", "max_length"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Section summary",
        "properties": {
          "title": { "type": "string" },
          "section_title": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["title", "section_title", "summary"]
      }
    },
    {
      "name": "extract_key_facts",
      "description": "Extract key facts from a Wikipedia article, optionally focused on a topic.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article."
          },
          "topic_within_article": {
            "type": ["string", "null"],
            "description": "Topic/section to focus fact extraction on."
          }
        },
        "required": ["title", "topic_within_article"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Key facts from the article",
        "properties": {
          "title": { "type": "string" },
          "topic_within_article": { "type": "string" },
          "facts": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["title", "topic_within_article", "facts"]
      }
    },
    {
      "name": "get_related_topics",
      "description": "Get topics related to a Wikipedia article based on links and categories.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article."
          }
        },
        "required": ["title"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Related topics from the article",
        "properties": {
          "title": { "type": "string" },
          "related_topics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "summary": { "type": "string" },
                "url": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        },
        "required": ["title", "related_topics"]
      }
    },
    {
      "name": "get_sections",
      "description": "Get the sections of a Wikipedia article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article."
          }
        },
        "required": ["title"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Article sections",
        "properties": {
          "title": { "type": "string" },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "level": { "type": "number" },
                "text": { "type": "string" },
                "sections": { "type": "array" }
              },
              "required": ["title", "level", "text", "sections"]
            }
          }
        },
        "required": ["title", "sections"]
      }
    },
    {
      "name": "get_links",
      "description": "Get the links contained within a Wikipedia article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article."
          }
        },
        "required": ["title"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Article links",
        "properties": {
          "title": { "type": "string" },
          "links": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": ["title", "links"]
      }
    },
    {
      "name": "get_coordinates",
      "description": "Get the coordinates of a Wikipedia article.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the Wikipedia article."
          }
        },
        "required": ["title"]
      },
      "outputSchema": {
        "type": "object",
        "description": "Geographic coordinates",
        "properties": {
          "title": { "type": "string" },
          "page_id": { "type": "number" },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "latitude": { "type": "number" },
                "longitude": { "type": "number" },
                "primary": { "type": "boolean" },
                "globe": { "type": "string" },
                "type": { "type": "string" },
                "name": { "type": "string" },
                "region": { "type": "string" },
                "country": { "type": "string" }
              },
              "required": [
                "latitude",
                "longitude",
                "primary",
                "globe",
                "type",
                "name",
                "region",
                "country"
              ]
            }
          }
        },
        "required": ["title", "page_id", "coordinates"]
      }
    }
  ]
}
